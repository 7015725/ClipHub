    /* REGEX_BETA_FEATURE_BEGIN */
    var REGEX_FLAG_IGNORE_CASE = 1;
    var REGEX_FLAG_MULTILINE = 2;
    var REGEX_FLAG_DOTALL = 4;
    var REGEX_SCAN_CHUNK_SIZE = 128;
    var REGEX_SCAN_CHUNK_TEXT_CHAR_BUDGET = 786432;
    var REGEX_SCAN_ITEM_TEXT_CHAR_BUDGET = 786432;

    function normalizeRegexTitle(value) {
        var text = String(value === null || value === undefined ? "" : value)
            .replace(/^\s+|\s+$/g, "");
        return String(new JavaString(text).toLowerCase(
            Packages.java.util.Locale.ROOT));
    }

    function normalizeRegexText(value, maximum) {
        var text = String(value === null || value === undefined ? "" : value);
        if (maximum !== undefined && text.length > Number(maximum)) {
            throw new Error("regex_text_too_long");
        }
        return text;
    }

    function normalizeRegexFlags(value) {
        var flags = intValue(value, 0);
        if (flags < 0 || flags > 7) {
            throw new Error("regex_flags_invalid");
        }
        return flags;
    }

    function javaRegexFlags(flags) {
        var Pattern = Packages.java.util.regex.Pattern;
        var result = 0;
        flags = normalizeRegexFlags(flags);
        if ((flags & REGEX_FLAG_IGNORE_CASE) !== 0) {
            result |= Number(Pattern.CASE_INSENSITIVE);
            result |= Number(Pattern.UNICODE_CASE);
        }
        if ((flags & REGEX_FLAG_MULTILINE) !== 0) {
            result |= Number(Pattern.MULTILINE);
        }
        if ((flags & REGEX_FLAG_DOTALL) !== 0) {
            result |= Number(Pattern.DOTALL);
        }
        return result;
    }

    function regexQuantifierAt(text, index) {
        var ch = text.charAt(index);
        var end;
        var body;
        var comma;
        var minimum;
        if (ch === "*" || ch === "+") {
            return { found: true, unbounded: true,
                minimum: ch === "+" ? 1 : 0, end: index + 1 };
        }
        if (ch === "?") {
            return { found: true, unbounded: false,
                minimum: 0, end: index + 1 };
        }
        if (ch !== "{") { return null; }
        end = text.indexOf("}", index + 1);
        if (end < 0) { return null; }
        body = text.substring(index + 1, end);
        if (!/^\d+(?:,\d*)?$/.test(body)) { return null; }
        comma = body.indexOf(",");
        minimum = Number(comma < 0 ? body : body.substring(0, comma));
        return {
            found: true,
            unbounded: comma >= 0 && comma === body.length - 1,
            minimum: minimum,
            end: end + 1
        };
    }

    function regexGroupBodyStart(text, index) {
        var close;
        if (text.substr(index, 3) === "(?:" ||
                text.substr(index, 3) === "(?=" ||
                text.substr(index, 3) === "(?!" ||
                text.substr(index, 3) === "(?>") {
            return index + 3;
        }
        if (text.substr(index, 4) === "(?<=" ||
                text.substr(index, 4) === "(?<!") {
            return index + 4;
        }
        if (text.substr(index, 3) === "(?<") {
            close = text.indexOf(">", index + 3);
            if (close > index + 3) { return close + 1; }
        }
        return index + 1;
    }

    function regexContainsUnboundedQuantifier(text) {
        var index = 0;
        var inClass = false;
        var escaped = false;
        var quantifier;
        while (index < text.length) {
            if (escaped) {
                escaped = false;
                index += 1;
                continue;
            }
            if (text.charAt(index) === "\\") {
                escaped = true;
                index += 1;
                continue;
            }
            if (text.charAt(index) === "[") {
                inClass = true;
                index += 1;
                continue;
            }
            if (text.charAt(index) === "]" && inClass) {
                inClass = false;
                index += 1;
                continue;
            }
            if (!inClass) {
                quantifier = regexQuantifierAt(text, index);
                if (quantifier !== null) {
                    if (quantifier.unbounded) { return true; }
                    index = quantifier.end;
                    continue;
                }
            }
            index += 1;
        }
        return false;
    }

    function regexSplitTopLevelAlternatives(text) {
        var output = [];
        var start = 0;
        var depth = 0;
        var inClass = false;
        var escaped = false;
        var index;
        var ch;
        for (index = 0; index < text.length; index += 1) {
            ch = text.charAt(index);
            if (escaped) {
                escaped = false;
                continue;
            }
            if (ch === "\\") {
                escaped = true;
                continue;
            }
            if (ch === "[") { inClass = true; continue; }
            if (ch === "]" && inClass) { inClass = false; continue; }
            if (inClass) { continue; }
            if (ch === "(") { depth += 1; continue; }
            if (ch === ")" && depth > 0) { depth -= 1; continue; }
            if (ch === "|" && depth === 0) {
                output.push(text.substring(start, index));
                start = index + 1;
            }
        }
        output.push(text.substring(start));
        return output;
    }

    function regexSimpleLiteral(text) {
        var output = "";
        var index;
        var ch;
        var next;
        for (index = 0; index < text.length; index += 1) {
            ch = text.charAt(index);
            if (ch === "\\") {
                if (index + 1 >= text.length) { return null; }
                next = text.charAt(index + 1);
                if (".^$*+?{}[]()|\\".indexOf(next) < 0) { return null; }
                output += next;
                index += 1;
                continue;
            }
            if (".^$*+?{}[]()|".indexOf(ch) >= 0) { return null; }
            output += ch;
        }
        return output;
    }

    function regexAlternationHasPrefixOverlap(body) {
        var parts = regexSplitTopLevelAlternatives(body);
        var literals = [];
        var index;
        var other;
        var literal;
        if (parts.length < 2) { return false; }
        for (index = 0; index < parts.length; index += 1) {
            literal = regexSimpleLiteral(parts[index]);
            if (literal === null || literal.length < 1) { return false; }
            literals.push(literal);
        }
        for (index = 0; index < literals.length; index += 1) {
            for (other = index + 1; other < literals.length; other += 1) {
                if (literals[index].indexOf(literals[other]) === 0 ||
                        literals[other].indexOf(literals[index]) === 0) {
                    return true;
                }
            }
        }
        return false;
    }

    function regexFindGroupEnd(text, start) {
        var depth = 0;
        var inClass = false;
        var escaped = false;
        var index;
        var ch;
        for (index = start; index < text.length; index += 1) {
            ch = text.charAt(index);
            if (escaped) { escaped = false; continue; }
            if (ch === "\\") { escaped = true; continue; }
            if (ch === "[") { inClass = true; continue; }
            if (ch === "]" && inClass) { inClass = false; continue; }
            if (inClass) { continue; }
            if (ch === "(") { depth += 1; }
            else if (ch === ")") {
                depth -= 1;
                if (depth === 0) { return index; }
            }
        }
        return -1;
    }

    function regexSequenceCanBeEmpty(text) {
        var index = 0;
        var atomNullable;
        var end;
        var quantifier;
        var ch;
        while (index < text.length) {
            ch = text.charAt(index);
            if (ch === "^" || ch === "$") { index += 1; continue; }
            atomNullable = false;
            if (ch === "(") {
                end = regexFindGroupEnd(text, index);
                if (end < 0) { return false; }
                atomNullable = regexBodyCanBeEmpty(
                    text.substring(regexGroupBodyStart(text, index), end));
                index = end + 1;
            } else if (ch === "[") {
                end = index + 1;
                while (end < text.length) {
                    if (text.charAt(end) === "\\") { end += 2; continue; }
                    if (text.charAt(end) === "]") { break; }
                    end += 1;
                }
                if (end >= text.length) { return false; }
                index = end + 1;
            } else if (ch === "\\") {
                if (index + 1 >= text.length) { return false; }
                if ("bBAZGz".indexOf(text.charAt(index + 1)) >= 0) {
                    atomNullable = true;
                }
                index += 2;
            } else {
                index += 1;
            }
            quantifier = regexQuantifierAt(text, index);
            if (quantifier !== null) {
                if (quantifier.minimum === 0) { atomNullable = true; }
                index = quantifier.end;
                if (text.charAt(index) === "?") { index += 1; }
            }
            if (!atomNullable) { return false; }
        }
        return true;
    }

    function regexBodyCanBeEmpty(body) {
        var alternatives = regexSplitTopLevelAlternatives(body);
        var index;
        for (index = 0; index < alternatives.length; index += 1) {
            if (regexSequenceCanBeEmpty(alternatives[index])) { return true; }
        }
        return false;
    }

    function scanRegexStructure(patternText) {
        var text = String(patternText === null || patternText === undefined ?
            "" : patternText);
        var stack = [];
        var groups = [];
        var inClass = false;
        var escaped = false;
        var index;
        var ch;
        var group;
        var quantifier;
        for (index = 0; index < text.length; index += 1) {
            ch = text.charAt(index);
            if (escaped) { escaped = false; continue; }
            if (ch === "\\") { escaped = true; continue; }
            if (ch === "[") { inClass = true; continue; }
            if (ch === "]" && inClass) { inClass = false; continue; }
            if (inClass) { continue; }
            if (ch === "(") {
                stack.push({ start: index,
                    bodyStart: regexGroupBodyStart(text, index) });
            } else if (ch === ")" && stack.length > 0) {
                group = stack.pop();
                quantifier = regexQuantifierAt(text, index + 1);
                group.end = index;
                group.body = text.substring(group.bodyStart, index);
                group.outerUnbounded = quantifier !== null && quantifier.unbounded;
                groups.push(group);
            }
        }
        return { text: text, groups: groups };
    }

    function regexGroupRisk(group) {
        if (!group || group.outerUnbounded !== true) {
            return { risky: false, code: "", reason: "" };
        }
        if (regexContainsUnboundedQuantifier(group.body)) {
            return { risky: true, code: "nested_unbounded_quantifier",
                reason: "nested unbounded quantifier" };
        }
        if (regexBodyCanBeEmpty(group.body)) {
            return { risky: true, code: "nullable_unbounded_group",
                reason: "nullable group repeated without upper bound" };
        }
        if (/\\[1-9]/.test(group.body)) {
            return { risky: true, code: "backreference_in_unbounded_group",
                reason: "backreference inside unbounded group" };
        }
        if (group.body.indexOf(".*") >= 0 || group.body.indexOf(".+") >= 0) {
            return { risky: true, code: "wildcard_in_unbounded_group",
                reason: "overlapping wildcard inside unbounded group" };
        }
        if (regexAlternationHasPrefixOverlap(group.body)) {
            return { risky: true, code: "overlapping_alternation",
                reason: "overlapping literal alternation" };
        }
        return { risky: false, code: "", reason: "" };
    }

    function assessRegexRisk(patternText) {
        var structure = scanRegexStructure(patternText);
        var text = structure.text;
        var index;
        var risk;
        var sameClass = /(\[[^\]]+\]|\\[dDsSwW])(?:\+|\*|\{\d+,\})\1(?:\+|\*|\{\d+,\})/;
        if (text.indexOf(".*.*") >= 0 || text.indexOf(".+.+") >= 0 ||
                sameClass.test(text)) {
            return { risky: true, code: "overlapping_unbounded_tokens",
                reason: "overlapping unbounded tokens" };
        }
        for (index = 0; index < structure.groups.length; index += 1) {
            risk = regexGroupRisk(structure.groups[index]);
            if (risk.risky) { return risk; }
        }
        return { risky: false, code: "", reason: "" };
    }

    function validateRegexPolicy(pattern, flags, options) {
        var text = normalizeRegexText(pattern, 4096);
        var risk;
        normalizeRegexFlags(flags);
        if (text.length < 1) {
            throw new Error("regex_pattern_empty");
        }
        risk = assessRegexRisk(text);
        if (risk.risky && !(options && options.allowRisky === true)) {
            throw new Error("regex_pattern_risky: " + risk.code);
        }
        return text;
    }

    function validateRegexPattern(pattern, flags, options) {
        var text = validateRegexPolicy(pattern, flags, options);
        try {
            Packages.java.util.regex.Pattern.compile(
                text, javaRegexFlags(flags));
        } catch (error) {
            throw new Error("regex_pattern_invalid: " + String(error));
        }
        return text;
    }

    function regexRuleInput(input) {
        var title;
        var normalizedTitle;
        var note;
        var pattern;
        var flags;
        input = input || {};
        title = String(input.title === null || input.title === undefined ?
            "" : input.title).replace(/^\s+|\s+$/g, "");
        if (title.length < 1) { throw new Error("regex_title_empty"); }
        if (title.length > 64) { throw new Error("regex_title_too_long"); }
        normalizedTitle = normalizeRegexTitle(title);
        note = normalizeRegexText(input.note, 500);
        flags = normalizeRegexFlags(input.flags);
        pattern = validateRegexPattern(input.pattern, flags, {
            allowRisky: input.enabled === false
        });
        return {
            title: title,
            titleNormalized: normalizedTitle,
            note: note,
            pattern: pattern,
            flags: flags,
            enabled: input.enabled === false ? 0 : 1
        };
    }

    function getRegexRule(id) {
        requireReady();
        return ClipHub.Database.queryOne(
            "SELECT * FROM regex_rules WHERE id = ? LIMIT 1",
            [intValue(id, -1)]
        );
    }

    function getRegexRuleByNormalizedTitle(titleNormalized) {
        requireReady();
        return ClipHub.Database.queryOne(
            "SELECT * FROM regex_rules WHERE title_normalized = ? LIMIT 1",
            [String(titleNormalized || "")]
        );
    }

    function listRegexRules(options) {
        var where = [];
        var args = [];
        var keyword;
        options = options || {};
        requireReady();
        if (options.enabledOnly === true) {
            where.push("enabled = 1");
        }
        keyword = String(options.searchKeyword === null ||
            options.searchKeyword === undefined ? "" : options.searchKeyword)
            .replace(/^\s+|\s+$/g, "");
        if (keyword.length > 0) {
            keyword = "%" + escapeLike(keyword) + "%";
            where.push("(title LIKE ? ESCAPE '\\' OR note LIKE ? ESCAPE '\\')");
            args.push(keyword);
            args.push(keyword);
        } else {
            keyword = String(options.titleKeyword === null ||
                options.titleKeyword === undefined ? "" : options.titleKeyword)
                .replace(/^\s+|\s+$/g, "");
            if (keyword.length > 0) {
                where.push("title LIKE ? ESCAPE '\\'");
                args.push("%" + escapeLike(keyword) + "%");
            }
        }
        return ClipHub.Database.queryAll(
            "SELECT * FROM regex_rules" +
            (where.length > 0 ? " WHERE " + where.join(" AND ") : "") +
            " ORDER BY manual_order ASC, id ASC",
            args
        );
    }

    function nextRegexManualOrder() {
        return Number(ClipHub.Database.scalarLong(
            "SELECT COALESCE(MAX(manual_order), 0) FROM regex_rules",
            [], 0)) + 1000;
    }

    function createRegexRule(input) {
        var rule = regexRuleInput(input);
        var existing;
        var now;
        requireReady();
        existing = getRegexRuleByNormalizedTitle(rule.titleNormalized);
        if (existing !== null) { throw new Error("regex_title_conflict"); }
        now = ClipHub.Base.now();
        try {
            return Number(ClipHub.Database.executeInsert(
                "INSERT INTO regex_rules(title, title_normalized, note, " +
                "pattern, flags, enabled, manual_order, created_at, updated_at) " +
                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
                [rule.title, rule.titleNormalized, rule.note, rule.pattern,
                    rule.flags, rule.enabled,
                    input && input.manualOrder !== undefined ?
                        intValue(input.manualOrder, nextRegexManualOrder()) :
                        nextRegexManualOrder(),
                    now, now]
            ));
        } catch (error) {
            existing = getRegexRuleByNormalizedTitle(rule.titleNormalized);
            if (existing !== null) { throw new Error("regex_title_conflict"); }
            throw error;
        }
    }

    function updateRegexRule(id, input) {
        var rule = regexRuleInput(input);
        var existing;
        var targetId = intValue(id, -1);
        requireReady();
        if (getRegexRule(targetId) === null) {
            throw new Error("regex_rule_missing");
        }
        existing = getRegexRuleByNormalizedTitle(rule.titleNormalized);
        if (existing !== null && Number(existing.id) !== targetId) {
            throw new Error("regex_title_conflict");
        }
        try {
            return ClipHub.Database.executeUpdateDelete(
                "UPDATE regex_rules SET title = ?, title_normalized = ?, " +
                "note = ?, pattern = ?, flags = ?, enabled = ?, updated_at = ? " +
                "WHERE id = ?",
                [rule.title, rule.titleNormalized, rule.note, rule.pattern,
                    rule.flags, rule.enabled, ClipHub.Base.now(), targetId]
            );
        } catch (error) {
            existing = getRegexRuleByNormalizedTitle(rule.titleNormalized);
            if (existing !== null && Number(existing.id) !== targetId) {
                throw new Error("regex_title_conflict");
            }
            throw error;
        }
    }

    function deleteRegexRule(id) {
        requireReady();
        return ClipHub.Database.executeUpdateDelete(
            "DELETE FROM regex_rules WHERE id = ?", [intValue(id, -1)]);
    }

    function setRegexRuleEnabled(id, enabled) {
        var targetId = intValue(id, -1);
        var rule;
        var risk;
        requireReady();
        if (enabled === true) {
            rule = getRegexRule(targetId);
            if (rule === null) { throw new Error("regex_rule_missing"); }
            risk = assessRegexRisk(rule.pattern);
            if (risk.risky) {
                throw new Error("regex_pattern_risky: " + risk.code);
            }
        }
        return ClipHub.Database.executeUpdateDelete(
            "UPDATE regex_rules SET enabled = ?, updated_at = ? WHERE id = ?",
            [enabled === true ? 1 : 0, ClipHub.Base.now(), targetId]
        );
    }

    function reorderRegexRules(ruleIds) {
        var ids = intList(ruleIds);
        var index;
        var changed = 0;
        requireReady();
        ClipHub.Database.transaction(function () {
            for (index = 0; index < ids.length; index += 1) {
                changed += ClipHub.Database.executeUpdateDelete(
                    "UPDATE regex_rules SET manual_order = ?, updated_at = ? " +
                    "WHERE id = ?",
                    [(index + 1) * 1000, ClipHub.Base.now(), ids[index]]
                );
            }
        });
        return { ok: true, updatedCount: changed, regexRuleIds: ids };
    }

    function duplicateRegexRule(id) {
        var source = getRegexRule(id);
        var sourceTitle;
        var candidate;
        var suffixNumber = 1;
        var suffix;
        var maximumBase;
        if (source === null) { throw new Error("regex_rule_missing"); }
        sourceTitle = String(source.title || "");
        while (true) {
            suffix = suffixNumber <= 1 ? " - 副本" :
                " - 副本 " + String(suffixNumber);
            maximumBase = Math.max(0, 64 - suffix.length);
            candidate = sourceTitle.substring(0, maximumBase) + suffix;
            if (getRegexRuleByNormalizedTitle(
                    normalizeRegexTitle(candidate)) === null) {
                break;
            }
            suffixNumber += 1;
        }
        return createRegexRule({
            title: candidate,
            note: source.note,
            pattern: source.pattern,
            flags: Number(source.flags || 0),
            enabled: Number(source.enabled || 0) === 1
        });
    }

    function regexMetaValue(key) {
        var row = ClipHub.Database.queryOne(
            "SELECT value FROM schema_meta WHERE key = ? LIMIT 1",
            [String(key)]
        );
        return row === null ? null : String(row.value);
    }

    function setRegexMetaValue(key, value) {
        return ClipHub.Database.executeInsert(
            "INSERT OR REPLACE INTO schema_meta(key, value) VALUES (?, ?)",
            [String(key), String(value)]
        );
    }

    function ensureDefaultRegexRules() {
        var initialized;
        var count;
        requireReady();
        initialized = regexMetaValue(
            "feature.regex_rules.defaults_initialized");
        if (initialized === "1") { return false; }
        ClipHub.Database.transaction(function () {
            count = Number(ClipHub.Database.scalarLong(
                "SELECT COUNT(*) FROM regex_rules", [], 0));
            if (count === 0) {
                createRegexRule({
                    title: "手机号",
                    note: "中国大陆 11 位手机号",
                    pattern: "(?<!\\d)1[3-9]\\d{9}(?!\\d)",
                    flags: 0,
                    enabled: true,
                    manualOrder: 1000
                });
                createRegexRule({
                    title: "邮箱",
                    note: "常见电子邮箱地址",
                    pattern: "[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+",
                    flags: 0,
                    enabled: true,
                    manualOrder: 2000
                });
                createRegexRule({
                    title: "URL",
                    note: "HTTP / HTTPS 地址",
                    pattern: "https?://[^\\s<>\"']+",
                    flags: 0,
                    enabled: true,
                    manualOrder: 3000
                });
                createRegexRule({
                    title: "验证码",
                    note: "短信 / OTP 验证码",
                    pattern: "(?:验证码|校验码|动态码|OTP)\\s*[:：]?\\s*[0-9]{4,8}(?!\\d)",
                    flags: REGEX_FLAG_IGNORE_CASE,
                    enabled: true,
                    manualOrder: 4000
                });
            }
            setRegexMetaValue(
                "feature.regex_rules.defaults_initialized", "1");
        });
        return true;
    }

    function regexBaseCriteria(criteria) {
        var output = {};
        var key;
        criteria = criteria || {};
        for (key in criteria) {
            if (criteria.hasOwnProperty(key) &&
                    key !== "regexRuleIds" && key !== "regexMatchMode") {
                output[key] = criteria[key];
            }
        }
        return output;
    }

    function getRegexScanSnapshot(criteria) {
        var base = regexBaseCriteria(criteria);
        var built = buildItemWhere(base);
        var maxId;
        var args;
        var total;
        requireReady();
        maxId = Number(ClipHub.Database.scalarLong(
            "SELECT COALESCE(MAX(id), 0) FROM clipboard_items " +
            "WHERE deleted_at IS NULL", [], 0));
        args = copyArray(built.args);
        args.push(maxId);
        total = Number(ClipHub.Database.scalarLong(
            "SELECT COUNT(*) FROM clipboard_items WHERE " + built.sql +
            " AND clipboard_items.id <= ?", args, 0));
        return {
            maxItemId: maxId,
            candidateTotal: total,
            sortMode: normalizeSortMode(base.sortMode),
            startedAt: ClipHub.Base.now()
        };
    }

    function countRegexCandidates(criteria, snapshot) {
        var base = regexBaseCriteria(criteria);
        var built = buildItemWhere(base);
        var args = copyArray(built.args);
        var maxId = snapshot && snapshot.maxItemId !== undefined ?
            Number(snapshot.maxItemId) : Number(ClipHub.Database.scalarLong(
                "SELECT COALESCE(MAX(id),0) FROM clipboard_items", [], 0));
        args.push(maxId);
        requireReady();
        return Number(ClipHub.Database.scalarLong(
            "SELECT COUNT(*) FROM clipboard_items WHERE " + built.sql +
            " AND clipboard_items.id <= ?", args, 0));
    }

    function listRegexCandidateChunk(options) {
        var criteria;
        var built;
        var whereParts;
        var args;
        var sortMode;
        var cursorSql;
        var limit;
        var rows;
        var boundedRows = [];
        var textChars = 0;
        var rowIndex;
        var rowChars;
        var lastConsumedRow = null;
        var consumedCount = 0;
        var oversizeSkippedCount = 0;
        options = options || {};
        criteria = regexBaseCriteria(options.criteria || {});
        built = buildItemWhere(criteria);
        whereParts = [built.sql, "clipboard_items.id <= ?"];
        args = copyArray(built.args);
        args.push(Number(options.snapshotMaxId || 0));
        sortMode = normalizeSortMode(criteria.sortMode);
        if (options.cursor) {
            cursorSql = buildAppendCursorWhere(sortMode, options.cursor, args);
            if (cursorSql) { whereParts.push(cursorSql); }
        }
        limit = positiveLimit(options.limit, REGEX_SCAN_CHUNK_SIZE, 256);
        rows = ClipHub.Database.queryAll(
            "SELECT clipboard_items.id, clipboard_items.content, " +
            "clipboard_items.updated_at, clipboard_items.source_label, " +
            "clipboard_items.source_package, clipboard_items.is_pinned, " +
            "clipboard_items.manual_order, clipboard_items.last_copied_at " +
            "FROM clipboard_items WHERE " + whereParts.join(" AND ") +
            " ORDER BY " + buildItemOrder(sortMode) + " LIMIT ?",
            args.concat([limit])
        );
        for (rowIndex = 0; rowIndex < rows.length; rowIndex += 1) {
            rowChars = String(rows[rowIndex].content === null ||
                rows[rowIndex].content === undefined ? "" :
                rows[rowIndex].content).length;
            if (rowChars > REGEX_SCAN_ITEM_TEXT_CHAR_BUDGET) {
                lastConsumedRow = rows[rowIndex];
                consumedCount += 1;
                oversizeSkippedCount += 1;
                continue;
            }
            if (boundedRows.length > 0 &&
                    textChars + rowChars > REGEX_SCAN_CHUNK_TEXT_CHAR_BUDGET) {
                break;
            }
            boundedRows.push(rows[rowIndex]);
            textChars += rowChars;
            lastConsumedRow = rows[rowIndex];
            consumedCount += 1;
            if (textChars >= REGEX_SCAN_CHUNK_TEXT_CHAR_BUDGET) { break; }
        }
        return {
            rows: boundedRows,
            consumedCount: consumedCount,
            oversizeSkippedCount: oversizeSkippedCount,
            nextCursor: lastConsumedRow !== null ?
                buildPageCursor(lastConsumedRow, sortMode) : null,
            hasMore: consumedCount < rows.length || rows.length >= limit,
            textChars: textChars
        };
    }

    function itemMatchesBaseCriteria(itemId, criteria) {
        var base = regexBaseCriteria(criteria);
        var built = buildItemWhere(base);
        var args = copyArray(built.args);
        requireReady();
        args.push(intValue(itemId, -1));
        return ClipHub.Database.queryOne(
            "SELECT clipboard_items.id, clipboard_items.content, " +
            "clipboard_items.updated_at, clipboard_items.source_label, " +
            "clipboard_items.source_package, clipboard_items.is_pinned, " +
            "clipboard_items.manual_order, clipboard_items.last_copied_at " +
            "FROM clipboard_items WHERE " + built.sql +
            " AND clipboard_items.id = ? LIMIT 1", args);
    }
    /* REGEX_BETA_FEATURE_END */
