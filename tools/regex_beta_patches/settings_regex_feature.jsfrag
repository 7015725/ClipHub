    /* REGEX_BETA_SETTINGS_BEGIN */
    function normalizeRegexRuleIdList(input) {
        var source = input instanceof Array ? input : [];
        var output = [];
        var seen = {};
        var index;
        var number;
        for (index = 0; index < source.length; index += 1) {
            number = Math.floor(Number(source[index]));
            if (isFinite(number) && number > 0 && !seen[number]) {
                seen[number] = true;
                output.push(number);
            }
        }
        return output;
    }

    function regexSettingErrorText(error) {
        var text = String(error || "");
        if (text.indexOf("regex_title_empty") >= 0) { return "标题不能为空"; }
        if (text.indexOf("regex_title_too_long") >= 0) { return "标题最多 64 字符"; }
        if (text.indexOf("regex_title_conflict") >= 0) { return "标题已存在"; }
        if (text.indexOf("regex_pattern_empty") >= 0) { return "正则表达式不能为空"; }
        if (text.indexOf("regex_text_too_long") >= 0) { return "输入内容超过长度限制"; }
        if (text.indexOf("regex_pattern_invalid") >= 0) {
            return "表达式无效：" + text.substring(text.indexOf(":") + 1)
                .replace(/^\s+|\s+$/g, "");
        }
        return text;
    }

    function emitRegexRulesChanged(reason, ruleId) {
        try {
            if (ClipHub.EventBus && typeof ClipHub.EventBus.emit === "function") {
                ClipHub.EventBus.emit("regex_rules_changed", {
                    reason: String(reason || "update"),
                    ruleId: ruleId === null || ruleId === undefined ?
                        null : Number(ruleId),
                    at: ClipHub.Base.now()
                });
            }
        } catch (ignored) {}
    }

    function resetRegexEditorViews() {
        regexTitleInput = null;
        regexNoteInput = null;
        regexPatternInput = null;
        regexIgnoreCaseView = null;
        regexMultilineView = null;
        regexDotAllView = null;
        regexEditorStatusView = null;
        regexTestTextInput = null;
        regexRuleRowViews = {};
        return true;
    }

    function setSettingsPage(page) {
        settingsPage = String(page || "root");
        releaseSettingsInputFocus("settings_page_change");
        resetImeAnchorSpacer();
        buildPage();
        return true;
    }

    function handleSettingsBack() {
        var ime = readSettingsImeState();
        if (ime.visible) {
            hideSettingsKeyboardOnMain();
            return true;
        }
        releaseSettingsInputFocus("managed_back");
        if (settingsPage === "regex_test") {
            settingsPage = "regex_editor";
            buildPage();
            return true;
        }
        if (settingsPage === "regex_editor") {
            settingsPage = "regex_rules";
            regexEditorRuleId = null;
            regexEditorDraft = null;
            buildPage();
            return true;
        }
        if (settingsPage === "regex_rules") {
            settingsPage = "root";
            buildPage();
            return true;
        }
        return closePage("managed_back");
    }

    function makeSettingsSubpageHeader(content, titleText, colors) {
        var header = new LinearLayout(appContext);
        var back = makeText("‹", 24, colors.icon, true);
        var title = makeText(titleText, 17, colors.textPrimary, true);
        var close = makeText("×", 22, colors.icon, true);
        var params;
        header.setOrientation(LinearLayout.HORIZONTAL);
        header.setGravity(Gravity.CENTER_VERTICAL);
        back.setGravity(Gravity.CENTER);
        back.setClickable(true);
        back.setBackground(roundedBackground(colors.surfaceMuted, null, 18));
        back.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { handleSettingsBack(); }
        }));
        header.addView(back, new LinearLayout.LayoutParams(dp(38), dp(38)));
        params = new LinearLayout.LayoutParams(
            0, LinearLayout.LayoutParams.WRAP_CONTENT, 1);
        params.leftMargin = dp(8);
        header.addView(title, params);
        close.setGravity(Gravity.CENTER);
        close.setClickable(true);
        close.setBackground(roundedBackground(colors.surfaceMuted, null, 18));
        close.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { closePage("button"); }
        }));
        header.addView(close, new LinearLayout.LayoutParams(dp(38), dp(38)));
        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(42));
        params.bottomMargin = dp(8);
        content.addView(header, params);
        return header;
    }

    function installSettingsContent(content) {
        sectionAnchorSpacer = new View(appContext);
        content.addView(sectionAnchorSpacer, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, 0));
        imeAnchorSpacer = new View(appContext);
        content.addView(imeAnchorSpacer, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, 0));
        contentRoot = content;
        scrollRoot.removeAllViews();
        scrollRoot.addView(content, new FrameLayout.LayoutParams(
            FrameLayout.LayoutParams.MATCH_PARENT,
            FrameLayout.LayoutParams.WRAP_CONTENT));
        scrollRoot.scrollTo(0, 0);
        uiState.scrollResetCount += 1;
        uiState.currentScrollYDp = 0;
        uiState.sectionAnchorSpacerHeightDp = 0;
        uiState.imeAnchorSpacerHeightDp = 0;
        focusedInput = null;
        focusedInputName = null;
        focusedVisibilityScheduled = false;
        uiState.focusedInputName = null;
        uiState.focusedInputVisible = false;
        uiState.renderCount += 1;
        return true;
    }

    function makeRegexRuleEntrySection(colors) {
        var section = makeSection(colors);
        var rules = ClipHub.Repository.listRegexRules({});
        var row = new LinearLayout(appContext);
        var label = makeText("正则表达式规则", 11,
            colors.textPrimary, true);
        var valueText = makeText(String(rules.length) + " 条  ›", 10,
            colors.accentStrong, false);
        makeSectionTitle(section, "高级筛选规则",
            "管理正则表达式；筛选时按标题选择规则", colors);
        row.setOrientation(LinearLayout.HORIZONTAL);
        row.setGravity(Gravity.CENTER_VERTICAL);
        row.setPadding(dp(10), dp(8), dp(10), dp(8));
        row.setBackground(roundedBackground(colors.surfaceMuted,
            colors.stroke, 11));
        row.setClickable(true);
        row.setFocusable(true);
        row.addView(label, new LinearLayout.LayoutParams(
            0, LinearLayout.LayoutParams.WRAP_CONTENT, 1));
        row.addView(valueText, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.WRAP_CONTENT,
            LinearLayout.LayoutParams.WRAP_CONTENT));
        row.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () {
                settingsPage = "regex_rules";
                buildPage();
            }
        }));
        section.addView(row, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(46)));
        regexSectionView = section;
        return section;
    }

    function moveRegexRule(ruleId, delta) {
        var rules = ClipHub.Repository.listRegexRules({});
        var ids = [];
        var current = -1;
        var target;
        var index;
        for (index = 0; index < rules.length; index += 1) {
            ids.push(Number(rules[index].id));
            if (Number(rules[index].id) === Number(ruleId)) { current = index; }
        }
        target = current + Number(delta);
        if (current < 0 || target < 0 || target >= ids.length) { return false; }
        ids.splice(current, 1);
        ids.splice(target, 0, Number(ruleId));
        try {
            ClipHub.Repository.reorderRegexRules(ids);
            uiState.regexReorderCount += 1;
            emitRegexRulesChanged("reorder", ruleId);
            buildPage();
            return true;
        } catch (error) {
            uiState.lastError = regexSettingErrorText(error);
            return false;
        }
    }

    function bindRegexRuleDrag(handle, rowRoot, ruleId) {
        var startY = 0;
        var dragging = false;
        handle.setOnTouchListener(new JavaAdapter(View.OnTouchListener, {
            onTouch: function (view, event) {
                var action = Number(event.getActionMasked());
                var delta;
                if (action === MotionEvent.ACTION_DOWN) {
                    startY = Number(event.getRawY());
                    dragging = true;
                    rowRoot.setAlpha(0.92);
                    return true;
                }
                if (action === MotionEvent.ACTION_MOVE && dragging) {
                    delta = Math.max(-dp(64), Math.min(dp(64),
                        Number(event.getRawY()) - startY));
                    rowRoot.setTranslationY(delta);
                    return true;
                }
                if ((action === MotionEvent.ACTION_UP ||
                        action === MotionEvent.ACTION_CANCEL) && dragging) {
                    delta = Number(event.getRawY()) - startY;
                    dragging = false;
                    rowRoot.setTranslationY(0);
                    rowRoot.setAlpha(1);
                    if (Math.abs(delta) >= dp(28)) {
                        return moveRegexRule(Number(ruleId), delta > 0 ? 1 : -1);
                    }
                    return true;
                }
                return false;
            }
        }));
    }

    function deleteRegexRuleConfirmed(ruleId, deleteView) {
        ruleId = Number(ruleId);
        if (pendingDeleteRegexRuleId !== ruleId) {
            pendingDeleteRegexRuleId = ruleId;
            uiState.regexDeleteConfirmCount += 1;
            deleteView.setText("确认删除");
            return false;
        }
        try {
            if (ClipHub.Repository.deleteRegexRule(ruleId) > 0) {
                pendingDeleteRegexRuleId = null;
                uiState.regexDeleteCount += 1;
                emitRegexRulesChanged("delete", ruleId);
                buildPage();
                return true;
            }
        } catch (error) {
            uiState.lastError = regexSettingErrorText(error);
        }
        return false;
    }

    function duplicateRegexRuleFromSettings(ruleId) {
        try {
            var id = Number(ClipHub.Repository.duplicateRegexRule(ruleId));
            uiState.regexDuplicateCount += 1;
            emitRegexRulesChanged("duplicate", id);
            buildPage();
            return id;
        } catch (error) {
            uiState.lastError = regexSettingErrorText(error);
            return -1;
        }
    }

    function toggleRegexRuleEnabledFromSettings(ruleId, enabled) {
        try {
            if (ClipHub.Repository.setRegexRuleEnabled(
                    Number(ruleId), enabled === true) > 0) {
                uiState.regexEnableToggleCount += 1;
                emitRegexRulesChanged(enabled ? "enable" : "disable", ruleId);
                buildPage();
                return true;
            }
        } catch (error) {
            uiState.lastError = regexSettingErrorText(error);
        }
        return false;
    }

    function openRegexEditor(ruleId) {
        var rule = ruleId === null || ruleId === undefined ? null :
            ClipHub.Repository.getRegexRule(Number(ruleId));
        regexEditorRuleId = rule === null ? null : Number(rule.id);
        regexEditorDraft = rule === null ? {
            title: "", note: "", pattern: "", flags: 0, enabled: true
        } : {
            title: String(rule.title || ""),
            note: String(rule.note || ""),
            pattern: String(rule.pattern || ""),
            flags: Number(rule.flags || 0),
            enabled: Number(rule.enabled || 0) === 1
        };
        settingsPage = "regex_editor";
        uiState.regexEditorOpen = true;
        uiState.regexEditorRuleId = regexEditorRuleId;
        buildPage();
        return true;
    }

    function captureRegexEditorDraft() {
        if (regexEditorDraft === null) {
            regexEditorDraft = { title: "", note: "", pattern: "",
                flags: 0, enabled: true };
        }
        if (regexTitleInput !== null) {
            regexEditorDraft.title = String(regexTitleInput.getText());
        }
        if (regexNoteInput !== null) {
            regexEditorDraft.note = String(regexNoteInput.getText());
        }
        if (regexPatternInput !== null) {
            regexEditorDraft.pattern = String(regexPatternInput.getText());
        }
        return regexEditorDraft;
    }

    function updateRegexFlagButtons(colors) {
        if (regexEditorDraft === null) { return; }
        function style(view, active) {
            if (view === null) { return; }
            view.setBackground(roundedBackground(
                active ? colors.accentStrong : colors.accentSoft,
                colors.accentBorder, 11));
            ClipHub.Theme.applyTextColor(view,
                active ? "#FFFFFFFF" : colors.accentStrong);
        }
        style(regexIgnoreCaseView, (regexEditorDraft.flags & 1) !== 0);
        style(regexMultilineView, (regexEditorDraft.flags & 2) !== 0);
        style(regexDotAllView, (regexEditorDraft.flags & 4) !== 0);
    }

    function toggleRegexEditorFlag(flag, colors) {
        captureRegexEditorDraft();
        if ((regexEditorDraft.flags & Number(flag)) !== 0) {
            regexEditorDraft.flags &= ~Number(flag);
        } else {
            regexEditorDraft.flags |= Number(flag);
        }
        updateRegexFlagButtons(colors);
        return true;
    }

    function saveRegexEditor() {
        var draft = captureRegexEditorDraft();
        var id;
        try {
            if (regexEditorRuleId === null) {
                id = Number(ClipHub.Repository.createRegexRule(draft));
                uiState.regexCreateCount += 1;
                emitRegexRulesChanged("create", id);
            } else {
                ClipHub.Repository.updateRegexRule(regexEditorRuleId, draft);
                id = regexEditorRuleId;
                uiState.regexUpdateCount += 1;
                emitRegexRulesChanged("update", id);
            }
            uiState.lastRegexValidationError = null;
            uiState.regexEditorOpen = false;
            uiState.regexEditorRuleId = null;
            regexEditorRuleId = null;
            regexEditorDraft = null;
            settingsPage = "regex_rules";
            buildPage();
            return true;
        } catch (error) {
            uiState.lastRegexValidationError = regexSettingErrorText(error);
            uiState.lastError = uiState.lastRegexValidationError;
            if (regexEditorStatusView !== null) {
                regexEditorStatusView.setText(uiState.lastRegexValidationError);
            }
            return false;
        }
    }

    function regexTestSourceText(source) {
        var manager;
        var clip;
        var item;
        source = String(source || "manual");
        if (source === "clipboard") {
            try {
                manager = appContext.getSystemService(Context.CLIPBOARD_SERVICE);
                if (manager === null || !manager.hasPrimaryClip()) { return ""; }
                clip = manager.getPrimaryClip();
                if (clip === null || clip.getItemCount() < 1) { return ""; }
                return String(clip.getItemAt(0).coerceToText(appContext));
            } catch (ignoredClipboard) { return ""; }
        }
        if (source === "latest") {
            item = ClipHub.Repository.getLatestActiveItem();
            return item === null ? "" : String(item.content || "");
        }
        return regexTestTextInput === null ? String(regexTestText || "") :
            String(regexTestTextInput.getText());
    }

    function ensureRegexTestExecutor() {
        if (regexTestExecutor === null || regexTestExecutor.isShutdown()) {
            regexTestExecutor =
                Packages.java.util.concurrent.Executors.newSingleThreadExecutor();
        }
        return regexTestExecutor;
    }

    function runRegexTest(source) {
        var draft = captureRegexEditorDraft();
        var inputText = regexTestSourceText(source);
        var patternText = String(draft.pattern || "");
        var flags = Number(draft.flags || 0);
        var generation = regexTestGeneration + 1;
        regexTestGeneration = generation;
        regexTestText = inputText;
        uiState.regexTestRunning = true;
        uiState.regexTestMatchCount = 0;
        uiState.regexTestTruncated = false;
        uiState.lastRegexValidationError = null;
        regexTestResultLines = [];
        if (inputText.length < 1) {
            uiState.regexTestRunning = false;
            uiState.lastRegexValidationError = "测试文本为空";
            buildPage();
            return false;
        }
        ensureRegexTestExecutor().submit(new Packages.java.lang.Runnable({
            run: function () {
                var lines = new Packages.java.util.ArrayList();
                var matcher;
                var pattern;
                var javaFlags = 0;
                var count = 0;
                var truncated = false;
                var matched;
                var errorText = null;
                try {
                    if ((flags & 1) !== 0) {
                        javaFlags |= Number(Packages.java.util.regex.Pattern.CASE_INSENSITIVE);
                        javaFlags |= Number(Packages.java.util.regex.Pattern.UNICODE_CASE);
                    }
                    if ((flags & 2) !== 0) {
                        javaFlags |= Number(Packages.java.util.regex.Pattern.MULTILINE);
                    }
                    if ((flags & 4) !== 0) {
                        javaFlags |= Number(Packages.java.util.regex.Pattern.DOTALL);
                    }
                    pattern = Packages.java.util.regex.Pattern.compile(
                        patternText, javaFlags);
                    matcher = pattern.matcher(inputText);
                    while (matcher.find()) {
                        count += 1;
                        if (count <= 100) {
                            matched = String(matcher.group());
                            if (matched.length > 200) {
                                matched = matched.substring(0, 200) + "…";
                            }
                            lines.add("#" + String(count) + "  " + matched +
                                "\n位置：" + String(matcher.start()) + "–" +
                                String(matcher.end()));
                        } else {
                            truncated = true;
                            break;
                        }
                    }
                } catch (error) {
                    errorText = regexSettingErrorText(error);
                }
                (function (postedLines, postedCount, postedTruncated,
                        postedError) {
                    mainHandler.post(new Packages.java.lang.Runnable({
                        run: function () {
                            var index;
                            if (generation !== regexTestGeneration || !ready) {
                                return;
                            }
                            regexTestResultLines = [];
                            for (index = 0; index < Number(postedLines.size());
                                    index += 1) {
                                regexTestResultLines.push(
                                    String(postedLines.get(index)));
                            }
                            uiState.regexTestRunning = false;
                            uiState.regexTestMatchCount = Number(postedCount);
                            uiState.regexTestTruncated = postedTruncated === true;
                            uiState.lastRegexValidationError = postedError;
                            buildPage();
                        }
                    }));
                }(lines, count, truncated, errorText));
            }
        }));
        buildPage();
        return true;
    }

    function makeRegexRuleRow(rule, colors) {
        var root = new LinearLayout(appContext);
        var titleRow = new LinearLayout(appContext);
        var handle = makeText("↕", 14, colors.textTertiary, true);
        var title = makeText(String(rule.title), 11, colors.textPrimary, true);
        var enabled = Number(rule.enabled || 0) === 1;
        var toggleView = makeButton(enabled ? "已启用" : "已停用",
            colors, false, false);
        var note = makeText(String(rule.note || ""), 9,
            colors.textSecondary, false);
        var actions = new LinearLayout(appContext);
        var edit = makeButton("编辑", colors, false, false);
        var duplicate = makeButton("复制", colors, false, false);
        var deleteView = makeButton("删除", colors, false, true);
        var params;
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(dp(9), dp(8), dp(9), dp(8));
        root.setBackground(roundedBackground(colors.surfaceMuted,
            colors.stroke, 11));
        titleRow.setOrientation(LinearLayout.HORIZONTAL);
        titleRow.setGravity(Gravity.CENTER_VERTICAL);
        titleRow.addView(handle, new LinearLayout.LayoutParams(dp(28), dp(30)));
        params = new LinearLayout.LayoutParams(0,
            LinearLayout.LayoutParams.WRAP_CONTENT, 1);
        params.leftMargin = dp(4);
        titleRow.addView(title, params);
        toggleView.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () {
                toggleRegexRuleEnabledFromSettings(rule.id, !enabled);
            }
        }));
        titleRow.addView(toggleView, new LinearLayout.LayoutParams(dp(64), dp(32)));
        root.addView(titleRow, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT));
        if (String(rule.note || "").length > 0) {
            params = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
            params.topMargin = dp(3);
            root.addView(note, params);
        }
        actions.setOrientation(LinearLayout.HORIZONTAL);
        edit.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { openRegexEditor(rule.id); }
        }));
        duplicate.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { duplicateRegexRuleFromSettings(rule.id); }
        }));
        deleteView.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () {
                deleteRegexRuleConfirmed(rule.id, deleteView);
            }
        }));
        actions.addView(edit, new LinearLayout.LayoutParams(0, dp(34), 1));
        params = new LinearLayout.LayoutParams(0, dp(34), 1);
        params.leftMargin = dp(5);
        actions.addView(duplicate, params);
        params = new LinearLayout.LayoutParams(0, dp(34), 1);
        params.leftMargin = dp(5);
        actions.addView(deleteView, params);
        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(34));
        params.topMargin = dp(7);
        root.addView(actions, params);
        bindRegexRuleDrag(handle, root, rule.id);
        regexRuleRowViews[String(Number(rule.id))] = {
            root: root, deleteView: deleteView, enabledView: toggleView
        };
        return root;
    }

    function buildRegexRulesPage(colors) {
        var content = new LinearLayout(appContext);
        var add = makeButton("+ 新增规则", colors, true, false);
        var rules = ClipHub.Repository.listRegexRules({});
        var index;
        var params;
        content.setOrientation(LinearLayout.VERTICAL);
        content.setPadding(dp(12), dp(8), dp(12), dp(28));
        makeSettingsSubpageHeader(content, "正则表达式规则", colors);
        add.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { openRegexEditor(null); }
        }));
        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(42));
        params.bottomMargin = dp(9);
        content.addView(add, params);
        regexRuleRowViews = {};
        for (index = 0; index < rules.length; index += 1) {
            params = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
            params.bottomMargin = dp(7);
            content.addView(makeRegexRuleRow(rules[index], colors), params);
        }
        uiState.regexRuleRowCount = rules.length;
        uiState.regexEditorOpen = false;
        uiState.settingsPage = "regex_rules";
        return installSettingsContent(content);
    }

    function makeRegexMultilineInput(hint, value, colors, inputName,
            minimumLines) {
        var input = makeInput(hint, value, colors, false, inputName);
        input.setSingleLine(false);
        input.setMinLines(Number(minimumLines || 3));
        input.setGravity(Gravity.TOP | Gravity.START);
        input.setInputType(InputType.TYPE_CLASS_TEXT |
            InputType.TYPE_TEXT_FLAG_MULTI_LINE |
            InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS);
        return input;
    }

    function buildRegexEditorPage(colors) {
        var content = new LinearLayout(appContext);
        var section = makeSection(colors);
        var flagsRow = new LinearLayout(appContext);
        var actions = new LinearLayout(appContext);
        var test = makeButton("测试正则", colors, false, false);
        var save = makeButton("保存", colors, true, false);
        var params;
        var draft = regexEditorDraft || { title: "", note: "", pattern: "",
            flags: 0, enabled: true };
        content.setOrientation(LinearLayout.VERTICAL);
        content.setPadding(dp(12), dp(8), dp(12), dp(28));
        makeSettingsSubpageHeader(content,
            regexEditorRuleId === null ? "新增正则规则" : "编辑正则规则",
            colors);
        regexTitleInput = makeInput("标题", draft.title, colors, false,
            "regex.title");
        regexNoteInput = makeRegexMultilineInput("备注（可选）", draft.note,
            colors, "regex.note", 2);
        regexPatternInput = makeRegexMultilineInput("正则表达式", draft.pattern,
            colors, "regex.pattern", 4);
        addField(section, "标题（1–64）", regexTitleInput, colors);
        addField(section, "备注（最多 500）", regexNoteInput, colors);
        addField(section, "正则表达式（1–4096）", regexPatternInput, colors);
        flagsRow.setOrientation(LinearLayout.HORIZONTAL);
        regexIgnoreCaseView = makeButton("忽略大小写", colors, false, false);
        regexMultilineView = makeButton("多行", colors, false, false);
        regexDotAllView = makeButton("DotAll", colors, false, false);
        regexIgnoreCaseView.setOnClickListener(new JavaAdapter(
            View.OnClickListener, { onClick: function () {
                toggleRegexEditorFlag(1, colors);
            }}));
        regexMultilineView.setOnClickListener(new JavaAdapter(
            View.OnClickListener, { onClick: function () {
                toggleRegexEditorFlag(2, colors);
            }}));
        regexDotAllView.setOnClickListener(new JavaAdapter(
            View.OnClickListener, { onClick: function () {
                toggleRegexEditorFlag(4, colors);
            }}));
        flagsRow.addView(regexIgnoreCaseView,
            new LinearLayout.LayoutParams(0, dp(36), 1));
        params = new LinearLayout.LayoutParams(0, dp(36), 1);
        params.leftMargin = dp(5);
        flagsRow.addView(regexMultilineView, params);
        params = new LinearLayout.LayoutParams(0, dp(36), 1);
        params.leftMargin = dp(5);
        flagsRow.addView(regexDotAllView, params);
        section.addView(flagsRow, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(36)));
        updateRegexFlagButtons(colors);
        regexEditorStatusView = makeText(
            String(uiState.lastRegexValidationError || ""), 9,
            "#FFB42323", false);
        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT);
        params.topMargin = dp(7);
        section.addView(regexEditorStatusView, params);
        actions.setOrientation(LinearLayout.HORIZONTAL);
        test.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () {
                captureRegexEditorDraft();
                settingsPage = "regex_test";
                buildPage();
            }
        }));
        save.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { saveRegexEditor(); }
        }));
        actions.addView(test, new LinearLayout.LayoutParams(0, dp(40), 1));
        params = new LinearLayout.LayoutParams(0, dp(40), 1);
        params.leftMargin = dp(7);
        actions.addView(save, params);
        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(40));
        params.topMargin = dp(9);
        section.addView(actions, params);
        addSection(content, section);
        uiState.regexEditorOpen = true;
        uiState.regexEditorRuleId = regexEditorRuleId;
        uiState.settingsPage = "regex_editor";
        return installSettingsContent(content);
    }

    function buildRegexTestPage(colors) {
        var content = new LinearLayout(appContext);
        var section = makeSection(colors);
        var sourceRow = new LinearLayout(appContext);
        var manual = makeButton("手动文本", colors, false, false);
        var clipboard = makeButton("系统剪贴板", colors, false, false);
        var latest = makeButton("最近一条", colors, false, false);
        var run = makeButton("执行测试", colors, true, false);
        var status;
        var index;
        var line;
        var params;
        content.setOrientation(LinearLayout.VERTICAL);
        content.setPadding(dp(12), dp(8), dp(12), dp(28));
        makeSettingsSubpageHeader(content, "正则测试", colors);
        regexTestTextInput = makeRegexMultilineInput(
            "输入测试文本", regexTestText, colors, "regex.test.text", 5);
        addField(section, "测试文本", regexTestTextInput, colors);
        sourceRow.setOrientation(LinearLayout.HORIZONTAL);
        manual.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { runRegexTest("manual"); }
        }));
        clipboard.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { runRegexTest("clipboard"); }
        }));
        latest.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { runRegexTest("latest"); }
        }));
        sourceRow.addView(manual, new LinearLayout.LayoutParams(0, dp(34), 1));
        params = new LinearLayout.LayoutParams(0, dp(34), 1);
        params.leftMargin = dp(5);
        sourceRow.addView(clipboard, params);
        params = new LinearLayout.LayoutParams(0, dp(34), 1);
        params.leftMargin = dp(5);
        sourceRow.addView(latest, params);
        section.addView(sourceRow, new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(34)));
        run.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () { runRegexTest("manual"); }
        }));
        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT, dp(40));
        params.topMargin = dp(7);
        section.addView(run, params);
        status = makeText(uiState.regexTestRunning ? "正在测试…" :
            (uiState.lastRegexValidationError ?
                String(uiState.lastRegexValidationError) :
                "匹配次数：" + String(uiState.regexTestMatchCount)),
            10, colors.textSecondary, true);
        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT);
        params.topMargin = dp(9);
        params.bottomMargin = dp(6);
        section.addView(status, params);
        for (index = 0; index < regexTestResultLines.length; index += 1) {
            line = makeText(String(regexTestResultLines[index]), 9,
                colors.textPrimary, false);
            line.setTextIsSelectable(true);
            params = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
            params.bottomMargin = dp(5);
            section.addView(line, params);
        }
        if (uiState.regexTestTruncated) {
            section.addView(makeText("仅显示前 100 个匹配", 9,
                colors.textSecondary, false), new LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.MATCH_PARENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT));
        }
        addSection(content, section);
        uiState.settingsPage = "regex_test";
        return installSettingsContent(content);
    }

    var buildPage = function () {
        var colors;
        if (scrollRoot === null) { return false; }
        resetRegexEditorViews();
        if (settingsPage === "regex_rules") {
            colors = palette();
            return buildRegexRulesPage(colors);
        }
        if (settingsPage === "regex_editor") {
            colors = palette();
            return buildRegexEditorPage(colors);
        }
        if (settingsPage === "regex_test") {
            colors = palette();
            return buildRegexTestPage(colors);
        }
        uiState.settingsPage = "root";
        return buildRootPage();
    };
    /* REGEX_BETA_SETTINGS_END */
