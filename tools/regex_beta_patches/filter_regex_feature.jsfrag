    /* REGEX_BETA_FILTER_BEGIN */
    var MAX_REGEX_CACHE_ENTRIES = 8;
    var MAX_REGEX_CACHE_IDS = 16000;
    var regexResultCacheOrder = [];
    var regexResultCacheIdCount = 0;

    function validateRegexMatchMode(mode) {
        mode = String(mode || "any");
        return mode === "all" ? "all" : "any";
    }

    function regexActive() {
        return value !== null && value.regexRuleIds instanceof Array &&
            value.regexRuleIds.length > 0;
    }

    function copyRegexScanState() {
        return {
            running: regexScanState.running === true,
            generation: Number(regexScanState.generation),
            scanned: Number(regexScanState.scanned),
            total: Number(regexScanState.total),
            matched: Number(regexScanState.matched),
            firstBatchPublished: regexScanState.firstBatchPublished === true,
            complete: regexScanState.complete === true,
            cacheHitCount: Number(regexScanState.cacheHitCount),
            cacheMissCount: Number(regexScanState.cacheMissCount),
            lastError: regexScanState.lastError
        };
    }

    function persistRegexCriteria() {
        if (!ClipHub.Database || !ClipHub.Database.isOpen()) { return false; }
        ClipHub.Database.transaction(function () {
            ClipHub.Database.executeInsert(
                "INSERT OR REPLACE INTO settings(key, value, updated_at) " +
                "VALUES (?, ?, ?)",
                ["filterRegexRuleIds", JSON.stringify(value.regexRuleIds),
                    ClipHub.Base.now()]
            );
            ClipHub.Database.executeInsert(
                "INSERT OR REPLACE INTO settings(key, value, updated_at) " +
                "VALUES (?, ?, ?)",
                ["filterRegexMatchMode", JSON.stringify(value.regexMatchMode),
                    ClipHub.Base.now()]
            );
        });
        return true;
    }

    function readRegexPersistedValue(key, fallback) {
        var row;
        var parsed;
        try {
            row = ClipHub.Database.queryOne(
                "SELECT value FROM settings WHERE key = ? LIMIT 1",
                [String(key)]);
            if (row === null) { return fallback; }
            parsed = JSON.parse(String(row.value));
            return parsed;
        } catch (ignored) { return fallback; }
    }

    function sanitizeRegexRuleIds(ids) {
        var rules = ClipHub.Repository.listRegexRules({ enabledOnly: true });
        var allowed = {};
        var output = [];
        var normalized = normalizeIdList(ids);
        var index;
        for (index = 0; index < rules.length; index += 1) {
            allowed[String(Number(rules[index].id))] = true;
        }
        for (index = 0; index < normalized.length; index += 1) {
            if (allowed[String(normalized[index])]) {
                output.push(normalized[index]);
            }
        }
        return output;
    }

    function loadRegexCriteriaPersistence() {
        var ids = readRegexPersistedValue("filterRegexRuleIds", []);
        var mode = readRegexPersistedValue("filterRegexMatchMode", "any");
        value.regexRuleIds = sanitizeRegexRuleIds(ids);
        value.regexMatchMode = validateRegexMatchMode(mode);
        persistRegexCriteria();
        return true;
    }

    function beginRegexDraft() {
        advancedDraftRegexRuleIds = copyList(value.regexRuleIds || []);
        advancedDraftRegexMatchMode =
            validateRegexMatchMode(value.regexMatchMode);
        regexPickerSearchText = "";
        regexPickerVisible = false;
        return true;
    }

    function discardRegexDraft() {
        advancedDraftRegexRuleIds = copyList(value.regexRuleIds || []);
        advancedDraftRegexMatchMode =
            validateRegexMatchMode(value.regexMatchMode);
        regexPickerSearchText = "";
        regexPickerVisible = false;
        return true;
    }

    function commitRegexDraft() {
        var ids = sanitizeRegexRuleIds(advancedDraftRegexRuleIds);
        var changed = JSON.stringify(ids) !== JSON.stringify(value.regexRuleIds) ||
            validateRegexMatchMode(advancedDraftRegexMatchMode) !==
                validateRegexMatchMode(value.regexMatchMode);
        value.regexRuleIds = ids;
        value.regexMatchMode =
            validateRegexMatchMode(advancedDraftRegexMatchMode);
        persistRegexCriteria();
        regexPickerVisible = false;
        regexPickerSearchText = "";
        if (changed) {
            clearRegexResultCache("regex_draft_apply");
            resetResultPaging("regex_draft_apply");
            if (regexActive()) {
                startRegexScan({ origin: "regex_draft_apply" });
            } else {
                cancelRegexScan("regex_disabled", true);
                apply({ origin: "regex_disabled", regexBypass: true });
            }
        }
        return changed;
    }

    function clearRegexResultCache(reason) {
        regexResultCache = {};
        regexResultCacheOrder = [];
        regexResultCacheIdCount = 0;
        regexScanState.lastCacheInvalidationReason = String(reason || "clear");
        return true;
    }

    function getRegexResultCache(signature) {
        var key = String(signature);
        var cached = regexResultCache[key];
        var index;
        if (!cached) { return null; }
        for (index = 0; index < regexResultCacheOrder.length; index += 1) {
            if (regexResultCacheOrder[index] === key) {
                regexResultCacheOrder.splice(index, 1);
                break;
            }
        }
        regexResultCacheOrder.push(key);
        return cached;
    }

    function putRegexResultCache(signature, matchedIds) {
        var key = String(signature);
        var ids = matchedIds instanceof Array ? matchedIds.slice(0) : [];
        var existing = regexResultCache[key];
        var oldest;
        var index;
        if (ids.length > MAX_REGEX_CACHE_IDS) { return false; }
        if (existing && existing.matchedIds instanceof Array) {
            regexResultCacheIdCount -= existing.matchedIds.length;
        }
        regexResultCache[key] = {
            matchedIds: ids,
            completedAt: ClipHub.Base.now()
        };
        regexResultCacheIdCount += ids.length;
        for (index = regexResultCacheOrder.length - 1; index >= 0; index -= 1) {
            if (regexResultCacheOrder[index] === key) {
                regexResultCacheOrder.splice(index, 1);
            }
        }
        regexResultCacheOrder.push(key);
        while (regexResultCacheOrder.length > MAX_REGEX_CACHE_ENTRIES ||
                regexResultCacheIdCount > MAX_REGEX_CACHE_IDS) {
            oldest = regexResultCacheOrder.shift();
            if (oldest === undefined) { break; }
            existing = regexResultCache[oldest];
            if (existing && existing.matchedIds instanceof Array) {
                regexResultCacheIdCount -= existing.matchedIds.length;
            }
            delete regexResultCache[oldest];
        }
        return true;
    }

    function cancelRegexScan(reason, clearResults) {
        regexScanGeneration += 1;
        regexScanState.generation = regexScanGeneration;
        regexScanState.running = false;
        regexScanState.complete = false;
        if (regexScanFuture !== null) {
            try { regexScanFuture.cancel(true); } catch (ignored) {}
            regexScanFuture = null;
        }
        if (clearResults === true) {
            regexMatchedIds = [];
            regexMatchedIdSet = {};
            regexCompiledRuleRows = [];
            regexScanState.scanned = 0;
            regexScanState.total = 0;
            regexScanState.matched = 0;
            regexScanState.firstBatchPublished = false;
        }
        regexScanState.lastCancelReason = String(reason || "cancel");
        return true;
    }

    function ensureRegexExecutor() {
        if (regexScanExecutor === null || regexScanExecutor.isShutdown()) {
            regexScanExecutor =
                Packages.java.util.concurrent.Executors.newSingleThreadExecutor();
        }
        return regexScanExecutor;
    }

    function regexJavaFlags(flags) {
        var Pattern = Packages.java.util.regex.Pattern;
        var result = 0;
        flags = Number(flags || 0);
        if ((flags & 1) !== 0) {
            result |= Number(Pattern.CASE_INSENSITIVE);
            result |= Number(Pattern.UNICODE_CASE);
        }
        if ((flags & 2) !== 0) { result |= Number(Pattern.MULTILINE); }
        if ((flags & 4) !== 0) { result |= Number(Pattern.DOTALL); }
        return result;
    }

    function compileRegexRuleSnapshot(ruleRows, selectedIds) {
        var selected = {};
        var output = [];
        var index;
        var rule;
        for (index = 0; index < selectedIds.length; index += 1) {
            selected[String(Number(selectedIds[index]))] = true;
        }
        for (index = 0; index < ruleRows.length; index += 1) {
            rule = ruleRows[index];
            if (Number(rule.enabled || 0) !== 1 ||
                    !selected[String(Number(rule.id))]) {
                continue;
            }
            var risk = ClipHub.Repository.assessRegexRisk(rule.pattern);
            if (risk.risky) {
                throw new Error("regex_pattern_risky: " + String(rule.id) +
                    ":" + risk.code);
            }
            output.push({
                id: Number(rule.id),
                updatedAt: Number(rule.updated_at || 0),
                pattern: Packages.java.util.regex.Pattern.compile(
                    String(rule.pattern), regexJavaFlags(rule.flags))
            });
        }
        return output;
    }

    function regexContentMatches(compiled, mode, content) {
        var index;
        var text = String(content === null || content === undefined ?
            "" : content);
        mode = validateRegexMatchMode(mode);
        if (compiled.length < 1) { return false; }
        if (mode === "all") {
            for (index = 0; index < compiled.length; index += 1) {
                if (!compiled[index].pattern.matcher(text).find()) {
                    return false;
                }
            }
            return true;
        }
        for (index = 0; index < compiled.length; index += 1) {
            if (compiled[index].pattern.matcher(text).find()) { return true; }
        }
        return false;
    }

    function regexScanSignature(ruleRows, snapshot, criteria) {
        var parts = [];
        var index;
        for (index = 0; index < ruleRows.length; index += 1) {
            if (contains(value.regexRuleIds, Number(ruleRows[index].id))) {
                parts.push(String(Number(ruleRows[index].id)) + ":" +
                    String(Number(ruleRows[index].updated_at || 0)) + ":" +
                    String(Number(ruleRows[index].enabled || 0)));
            }
        }
        return JSON.stringify({
            rules: parts,
            mode: validateRegexMatchMode(value.regexMatchMode),
            criteria: criteria,
            sortMode: validateSortMode(value.sortMode),
            maxItemId: Number(snapshot.maxItemId)
        });
    }

    function copyJavaIdList(javaList) {
        var output = [];
        var index;
        if (javaList === null || javaList === undefined) { return output; }
        for (index = 0; index < Number(javaList.size()); index += 1) {
            output.push(Number(javaList.get(index)));
        }
        return output;
    }

    function regexPendingPageResult(request) {
        return {
            pending: true,
            rows: previewRows.slice(0),
            appendedRows: [],
            allRows: previewRows.slice(0),
            options: request || {},
            hasMore: false,
            endCursor: null,
            totalCount: Number(regexScanState.matched || 0),
            totalPages: 0,
            pageNumber: Number(paginationState.pageNumber || 1),
            pagination: copyPaginationState(),
            regexScan: copyRegexScanState()
        };
    }

    function regexResultPageResult(request) {
        var append = paginationState.mode === "ajax" &&
            request && request.append === true;
        var pageSize = Math.max(1, Number(paginationState.pageSize || 100));
        var requestedPage = request && request.page !== undefined ?
            Math.max(1, Math.floor(Number(request.page))) :
            Math.max(1, Number(paginationState.pageNumber || 1));
        var start;
        var end;
        var ids;
        var rows;
        var appendedRows;
        var total = regexMatchedIds.length;
        var stableTotal = regexScanState.complete === true;
        var totalPages = stableTotal && total > 0 ?
            Math.ceil(total / pageSize) : (stableTotal ? 0 : 0);
        if (paginationState.mode === "number" && stableTotal &&
                totalPages > 0 && requestedPage > totalPages) {
            requestedPage = totalPages;
        }
        if (append) {
            start = previewRows.length;
        } else if (paginationState.mode === "number") {
            start = (requestedPage - 1) * pageSize;
        } else {
            start = 0;
        }
        end = Math.min(total, start + pageSize);
        ids = regexMatchedIds.slice(start, end);
        rows = ClipHub.Repository.listItemsByIds(ids, true);
        if (append) {
            appendedRows = uniqueAppendRows(previewRows, rows);
            previewRows = previewRows.concat(appendedRows);
        } else {
            appendedRows = rows.slice(0);
            previewRows = rows.slice(0);
            resetDataWindowState(true);
        }
        paginationState.pageNumber = paginationState.mode === "number" ?
            requestedPage : Math.max(1, Math.ceil(
                Math.max(1, previewRows.length) / pageSize));
        paginationState.loadedCount = previewRows.length;
        paginationState.totalCount = stableTotal ? total : regexScanState.matched;
        paginationState.totalPages = stableTotal ? totalPages : 0;
        paginationState.hasMore = stableTotal ? end < total : true;
        if (paginationState.mode === "ajax" && !stableTotal &&
                previewRows.length < regexMatchedIds.length) {
            paginationState.hasMore = true;
        }
        paginationState.endCursor = null;
        paginationState.loadCount += 1;
        paginationState.lastLoadMode = "regex_" + paginationState.repositoryMode;
        paginationState.lastError = null;
        resultHasMore = paginationState.hasMore;
        resultPageLimit = Math.max(pageSize, previewRows.length);
        state.loadedResultCount = previewRows.length;
        state.resultPageSize = pageSize;
        state.resultPageLimit = resultPageLimit;
        state.resultHasMore = resultHasMore;
        if (paginationState.repositoryMode === "number") {
            numberPagerState.currentPage = Number(paginationState.pageNumber);
            numberPagerState.totalPages = Number(paginationState.totalPages);
            numberPagerState.totalCount = Number(paginationState.totalCount);
            numberPagerState.selectedPage = Number(paginationState.pageNumber);
            numberPagerState.loading = !stableTotal;
        }
        return {
            rows: rows,
            appendedRows: appendedRows,
            allRows: previewRows.slice(0),
            options: request || {},
            hasMore: paginationState.hasMore,
            endCursor: null,
            totalCount: Number(paginationState.totalCount),
            totalPages: Number(paginationState.totalPages),
            pageNumber: Number(paginationState.pageNumber),
            pagination: copyPaginationState()
        };
    }

    function refreshRegexResultUi(origin) {
        if (!state.panelAttached) { return true; }
        if (ClipHub.List && typeof ClipHub.List.setItems === "function") {
            ClipHub.List.setItems(previewRows);
        }
        state.lastResultCount = previewRows.length;
        state.loadedResultCount = previewRows.length;
        refreshResultsOnMain();
        updateResultCountOnMain();
        emitChanged(previewRows, origin || "regex_scan");
        return true;
    }

    function publishRegexScanBatch(generation, javaIds, scanned,
            total, complete, cacheSignature) {
        var ids;
        var index;
        if (generation !== regexScanGeneration || !ready) { return false; }
        ids = copyJavaIdList(javaIds);
        for (index = 0; index < ids.length; index += 1) {
            if (!regexMatchedIdSet[String(ids[index])]) {
                regexMatchedIdSet[String(ids[index])] = true;
                regexMatchedIds.push(ids[index]);
            }
        }
        regexScanState.scanned = Number(scanned);
        regexScanState.total = Number(total);
        regexScanState.matched = regexMatchedIds.length;
        if (ids.length > 0 && !regexScanState.firstBatchPublished) {
            regexScanState.firstBatchPublished = true;
        }
        if (regexScanState.firstBatchPublished || complete === true) {
            regexResultPageResult({ append: false,
                page: paginationState.mode === "number" ?
                    paginationState.pageNumber : 1 });
            refreshRegexResultUi(complete ?
                "regex_scan_complete" : "regex_scan_batch");
        } else {
            updateResultCountOnMain();
        }
        if (complete === true) {
            regexScanState.running = false;
            regexScanState.complete = true;
            regexScanFuture = null;
            paginationState.totalCount = regexMatchedIds.length;
            paginationState.totalPages = regexMatchedIds.length > 0 ?
                Math.ceil(regexMatchedIds.length /
                    Math.max(1, Number(paginationState.pageSize))) : 0;
            paginationState.hasMore = previewRows.length < regexMatchedIds.length;
            if (paginationState.repositoryMode === "number") {
                numberPagerState.loading = false;
                numberPagerState.totalCount = paginationState.totalCount;
                numberPagerState.totalPages = paginationState.totalPages;
            }
            putRegexResultCache(cacheSignature, regexMatchedIds);
            refreshRegexResultUi("regex_scan_complete");
        }
        return true;
    }

    function startRegexScan(options) {
        var selected;
        var ruleRows;
        var snapshot;
        var baseCriteria;
        var signature;
        var cached;
        var generation;
        var selectedJson;
        var criteriaJson;
        var mode;
        options = options || {};
        if (!regexActive()) {
            cancelRegexScan("regex_not_active", true);
            return apply({ origin: options.origin || "regex_not_active",
                regexBypass: true });
        }
        selected = sanitizeRegexRuleIds(value.regexRuleIds);
        if (selected.length !== value.regexRuleIds.length) {
            value.regexRuleIds = selected;
            persistRegexCriteria();
        }
        if (selected.length < 1) {
            return apply({ origin: "regex_selection_empty", regexBypass: true });
        }
        ruleRows = ClipHub.Repository.listRegexRules({ enabledOnly: true });
        baseCriteria = toQueryOptions({ sortMode: value.sortMode });
        snapshot = ClipHub.Repository.getRegexScanSnapshot(baseCriteria);
        signature = regexScanSignature(ruleRows, snapshot, baseCriteria);
        cached = getRegexResultCache(signature);
        cancelRegexScan("regex_new_generation", true);
        generation = regexScanGeneration;
        regexScanState.generation = generation;
        regexScanState.total = Number(snapshot.candidateTotal || 0);
        regexScanState.lastError = null;
        if (cached && cached.matchedIds instanceof Array) {
            regexMatchedIds = cached.matchedIds.slice(0);
            regexMatchedIdSet = {};
            for (var cacheIndex = 0; cacheIndex < regexMatchedIds.length;
                    cacheIndex += 1) {
                regexMatchedIdSet[String(regexMatchedIds[cacheIndex])] = true;
            }
            regexScanState.scanned = regexScanState.total;
            regexScanState.matched = regexMatchedIds.length;
            regexScanState.running = false;
            regexScanState.complete = true;
            regexScanState.firstBatchPublished = regexMatchedIds.length > 0;
            regexScanState.cacheHitCount += 1;
            regexResultPageResult({ append: false,
                page: paginationState.mode === "number" ?
                    paginationState.pageNumber : 1 });
            refreshRegexResultUi("regex_cache_hit");
            return previewRows;
        }
        regexScanState.cacheMissCount += 1;
        regexScanState.running = true;
        regexScanState.complete = false;
        regexScanState.scanned = 0;
        regexScanState.matched = 0;
        regexScanState.firstBatchPublished = false;
        numberPagerState.loading = paginationState.mode === "number";
        selectedJson = JSON.stringify(selected);
        criteriaJson = JSON.stringify(baseCriteria);
        mode = validateRegexMatchMode(value.regexMatchMode);
        regexScanFuture = ensureRegexExecutor().submit(
            new Packages.java.lang.Runnable({ run: function () {
                var localSelected;
                var localCriteria;
                var localRules;
                var compiled;
                var cursor = null;
                var scanned = 0;
                var chunk;
                var rows;
                var batch;
                var index;
                var done;
                try {
                    localSelected = JSON.parse(selectedJson);
                    localCriteria = JSON.parse(criteriaJson);
                    localRules = ClipHub.Repository.listRegexRules({
                        enabledOnly: true });
                    compiled = compileRegexRuleSnapshot(
                        localRules, localSelected);
                    while (generation === regexScanGeneration) {
                        chunk = ClipHub.Repository.listRegexCandidateChunk({
                            criteria: localCriteria,
                            snapshotMaxId: Number(snapshot.maxItemId),
                            cursor: cursor,
                            limit: 128
                        });
                        rows = chunk.rows || [];
                        batch = new Packages.java.util.ArrayList();
                        for (index = 0; index < rows.length; index += 1) {
                            if (regexContentMatches(compiled, mode,
                                    rows[index].content)) {
                                batch.add(Packages.java.lang.Long.valueOf(
                                    Number(rows[index].id)));
                            }
                        }
                        scanned += rows.length;
                        cursor = chunk.nextCursor;
                        done = chunk.hasMore !== true ||
                            scanned >= Number(snapshot.candidateTotal || 0);
                        (function (postedBatch, postedScanned,
                                postedDone) {
                            mainHandler.post(new Packages.java.lang.Runnable({
                                run: function () {
                                    publishRegexScanBatch(generation,
                                        postedBatch, postedScanned,
                                        Number(snapshot.candidateTotal || 0),
                                        postedDone, signature);
                                }
                            }));
                        }(batch, scanned, done));
                        if (done) { break; }
                    }
                } catch (error) {
                    mainHandler.post(new Packages.java.lang.Runnable({
                        run: function () {
                            if (generation !== regexScanGeneration) { return; }
                            regexScanState.running = false;
                            regexScanState.complete = false;
                            regexScanState.lastError = String(error);
                            state.lastError = String(error);
                            numberPagerState.loading = false;
                            updateResultCountOnMain();
                        }
                    }));
                }
            }}));
        updateResultCountOnMain();
        return previewRows;
    }

    function onRegexRulesChanged(payload) {
        var oldIds;
        var newIds;
        var reason;
        var ruleId;
        var wasSelected;
        var selectionChanged;
        var requiresRescan = false;
        if (!ready) { return; }
        payload = payload || {};
        reason = String(payload.reason || "update");
        ruleId = payload.ruleId === null || payload.ruleId === undefined ?
            null : Number(payload.ruleId);
        oldIds = copyList(value.regexRuleIds || []);
        wasSelected = ruleId !== null && contains(oldIds, ruleId);
        newIds = sanitizeRegexRuleIds(oldIds);
        selectionChanged = JSON.stringify(oldIds) !== JSON.stringify(newIds);
        advancedDraftRegexRuleIds = sanitizeRegexRuleIds(
            advancedDraftRegexRuleIds || []);
        value.regexRuleIds = newIds;
        if (selectionChanged) { persistRegexCriteria(); }
        if (reason === "reorder" || reason === "create" ||
                reason === "duplicate") {
            requiresRescan = false;
        } else if (reason === "update" || reason === "delete" ||
                reason === "disable") {
            requiresRescan = wasSelected;
        } else if (reason === "enable") {
            requiresRescan = wasSelected;
        } else {
            requiresRescan = wasSelected || selectionChanged;
        }
        if (state.panelAttached && advancedVisible) {
            optionCountsDirty = true;
            rebuildAdvancedDrawerOnly();
            refreshAdvancedHeaderSummaryOnMain();
        }
        if (!requiresRescan) { return; }
        clearRegexResultCache("regex_rules_changed:" + reason);
        cancelRegexScan("regex_rules_changed:" + reason, true);
        resetResultPaging("regex_rules_changed:" + reason);
        if (newIds.length > 0) {
            startRegexScan({ origin: "regex_rules_changed:" + reason });
        } else if (state.panelAttached) {
            apply({ origin: "regex_rules_removed", regexBypass: true });
            refreshRegexResultUi("regex_rules_removed");
        }
    }

    function openRegexPicker() {
        regexPickerVisible = true;
        regexPickerSearchText = "";
        state.regexPickerOpenCount += 1;
        rebuildAdvancedDrawerOnly();
        return true;
    }

    function closeRegexPicker() {
        regexPickerVisible = false;
        regexPickerSearchText = "";
        state.regexPickerCloseCount += 1;
        rebuildAdvancedDrawerOnly();
        return true;
    }

    function toggleRegexDraftRule(ruleId) {
        advancedDraftRegexRuleIds = toggle(
            advancedDraftRegexRuleIds, Number(ruleId), true);
        state.regexRuleToggleCount += 1;
        state.drawerCriteriaChanged = true;
        rebuildAdvancedDrawerOnly();
        return true;
    }

    function clearRegexDraftRules() {
        advancedDraftRegexRuleIds = [];
        state.regexRuleClearCount += 1;
        state.drawerCriteriaChanged = true;
        rebuildAdvancedDrawerOnly();
        return true;
    }

    function setRegexDraftMode(mode) {
        advancedDraftRegexMatchMode = validateRegexMatchMode(mode);
        state.regexModeToggleCount += 1;
        state.drawerCriteriaChanged = true;
        rebuildAdvancedDrawerOnly();
        return true;
    }

    function regexRulePickerLabel(rule) {
        return String(rule && rule.title || "");
    }
    function styleRegexInlineChip(view, selected, colors) {
        if (view === null || view === undefined) { return false; }
        view.setBackground(roundedBackground(
            selected ? colors.accentSoft : colors.surface,
            selected ? colors.accentBorder : colors.stroke, 9));
        ClipHub.Theme.applyTextColor(view,
            selected ? colors.accentStrong : colors.textSecondary);
        view.setTypeface(Packages.android.graphics.Typeface.DEFAULT,
            selected ?
                Packages.android.graphics.Typeface.BOLD :
                Packages.android.graphics.Typeface.NORMAL);
        return true;
    }

    function refreshRegexInlineSelection(bundle, colors) {
        var selected = advancedDraftRegexRuleIds || [];
        var key;
        var view;
        if (bundle === null || bundle === undefined) { return false; }
        if (bundle.regexAllView !== null &&
                bundle.regexAllView !== undefined) {
            styleRegexInlineChip(bundle.regexAllView,
                selected.length === 0, colors);
        }
        if (bundle.regexRuleViews) {
            for (key in bundle.regexRuleViews) {
                if (bundle.regexRuleViews.hasOwnProperty(key)) {
                    view = bundle.regexRuleViews[key];
                    styleRegexInlineChip(view,
                        contains(selected, Number(key)), colors);
                }
            }
        }
        return true;
    }

    function makeRegexSourceStyleGrid(rules, colors, bundle) {
        var root = new LinearLayout(appContext);
        var row = null;
        var items = [{ all: true, id: 0, label: "全部" }];
        var metrics;
        var remaining;
        var rowsRemaining;
        var rowTarget = 0;
        var rowItems = 0;
        var rowCount = 0;
        var index;
        var rule;
        var item;
        var chip;
        var params;

        root.setOrientation(LinearLayout.VERTICAL);
        state.horizontalFadeEnabled = false;
        for (index = 0; index < rules.length && index < 30; index += 1) {
            rule = rules[index];
            items.push({
                all: false,
                id: Number(rule.id),
                label: regexRulePickerLabel(rule)
            });
        }

        metrics = adaptiveSourceGridMetrics(items.length);
        remaining = items.length;
        rowsRemaining = Math.max(1, Math.ceil(
            items.length / metrics.maxColumns));

        bundle.regexRuleViews = {};
        bundle.regexAllView = null;

        for (index = 0; index < items.length; index += 1) {
            item = items[index];
            chip = makeChip(item.label,
                item.all ?
                    advancedDraftRegexRuleIds.length === 0 :
                    contains(advancedDraftRegexRuleIds, item.id),
                colors, true);
            chip.setContentDescription(item.all ?
                "筛选正则规则 全部" :
                "筛选正则规则 " + String(item.id));

            if (item.all) {
                bundle.regexAllView = chip;
                chip.setOnClickListener(new JavaAdapter(
                    View.OnClickListener, {
                        onClick: function () {
                            markUiThread();
                            if (advancedDraftRegexRuleIds.length > 0) {
                                advancedDraftRegexRuleIds = [];
                                state.regexRuleClearCount += 1;
                                state.drawerCriteriaChanged = true;
                                refreshRegexInlineSelection(bundle, colors);
                            }
                        }
                    }));
            } else {
                (function (id, view) {
                    view.setOnClickListener(new JavaAdapter(
                        View.OnClickListener, {
                            onClick: function () {
                                markUiThread();
                                advancedDraftRegexRuleIds = toggle(
                                    advancedDraftRegexRuleIds, id, true);
                                state.regexRuleToggleCount += 1;
                                state.drawerCriteriaChanged = true;
                                refreshRegexInlineSelection(bundle, colors);
                            }
                        }));
                    bundle.regexRuleViews[String(id)] = view;
                }(item.id, chip));
            }

            if (row === null || rowItems >= rowTarget) {
                rowTarget = Math.max(1, Math.ceil(
                    remaining / rowsRemaining));
                row = new LinearLayout(appContext);
                row.setOrientation(LinearLayout.HORIZONTAL);
                row.setGravity(Gravity.CENTER_VERTICAL);
                params = new LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.MATCH_PARENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT);
                if (rowCount > 0) {
                    params.topMargin = metrics.gapPx;
                }
                root.addView(row, params);
                rowItems = 0;
                rowCount += 1;
            }

            params = new LinearLayout.LayoutParams(0,
                LinearLayout.LayoutParams.WRAP_CONTENT, 1);
            if (rowItems > 0) {
                params.leftMargin = metrics.gapPx;
            }
            row.addView(chip, params);
            rowItems += 1;
            remaining -= 1;
            if (rowItems >= rowTarget) {
                rowsRemaining = Math.max(0, rowsRemaining - 1);
            }
        }

        state.regexRuleWrapRowCount = rowCount;
        return root;
    }

    function addRegexInlineSection(content, colors, bundle) {
        var rules = ClipHub.Repository.listRegexRules({ enabledOnly: true });
        var sectionTitle = makeText("正则规则（多选）", 10,
            colors.textSecondary, true);
        var modeTitle = makeText("匹配方式", 9,
            colors.textSecondary, false);
        var modeRow = new LinearLayout(appContext);
        var anyChip = makeChip("任意规则 OR",
            advancedDraftRegexMatchMode !== "all", colors, true);
        var allChip = makeChip("全部规则 AND",
            advancedDraftRegexMatchMode === "all", colors, true);
        var emptyText;
        var params;

        bundle.regexRuleViews = {};
        bundle.regexAllView = null;
        bundle.regexModeViews = { any: anyChip, all: allChip };

        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT);
        params.topMargin = dp(3);
        params.bottomMargin = dp(5);
        content.addView(sectionTitle, params);

        if (rules.length < 1) {
            emptyText = makeText("暂无已启用的正则规则", 9,
                colors.textSecondary, false);
            params = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
            params.bottomMargin = dp(7);
            content.addView(emptyText, params);
            state.regexRuleOptionCount = 0;
        } else {
            params = new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT,
                LinearLayout.LayoutParams.WRAP_CONTENT);
            params.bottomMargin = dp(7);
            content.addView(makeRegexSourceStyleGrid(
                rules, colors, bundle), params);
            state.regexRuleOptionCount = Math.min(30, rules.length);
        }

        modeRow.setOrientation(LinearLayout.HORIZONTAL);
        modeRow.setGravity(Gravity.CENTER_VERTICAL);
        anyChip.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () {
                markUiThread();
                if (advancedDraftRegexMatchMode !== "any") {
                    advancedDraftRegexMatchMode = "any";
                    state.regexModeToggleCount += 1;
                    state.drawerCriteriaChanged = true;
                    styleRegexInlineChip(anyChip, true, colors);
                    styleRegexInlineChip(allChip, false, colors);
                }
            }
        }));
        allChip.setOnClickListener(new JavaAdapter(View.OnClickListener, {
            onClick: function () {
                markUiThread();
                if (advancedDraftRegexMatchMode !== "all") {
                    advancedDraftRegexMatchMode = "all";
                    state.regexModeToggleCount += 1;
                    state.drawerCriteriaChanged = true;
                    styleRegexInlineChip(anyChip, false, colors);
                    styleRegexInlineChip(allChip, true, colors);
                }
            }
        }));

        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT);
        params.bottomMargin = dp(4);
        content.addView(modeTitle, params);

        modeRow.addView(anyChip,
            new LinearLayout.LayoutParams(0,
                LinearLayout.LayoutParams.WRAP_CONTENT, 1));
        params = new LinearLayout.LayoutParams(0,
            LinearLayout.LayoutParams.WRAP_CONTENT, 1);
        params.leftMargin = dp(5);
        modeRow.addView(allChip, params);
        params = new LinearLayout.LayoutParams(
            LinearLayout.LayoutParams.MATCH_PARENT,
            LinearLayout.LayoutParams.WRAP_CONTENT);
        params.bottomMargin = dp(8);
        content.addView(modeRow, params);

        return true;
    }

    /* REGEX_BETA_FILTER_END */
